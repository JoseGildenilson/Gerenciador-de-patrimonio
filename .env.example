# ==========================================
# Variáveis de Ambiente - Gestão de Patrimônio
# ==========================================

# Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=internal_management
POSTGRES_PORT=5432

# URL de Conexão com o Banco de Dados
# No Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/internal_management
# Localmente fora do Docker (opcional):
# DATABASE_URL=sqlite:///./internal_management.db

# Configurações de Segurança e JWT
SECRET_KEY=super-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# Portas de Exposição dos Serviços
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=3000

# URL do Backend para o Proxy do Frontend (em desenvolvimento)
VITE_BACKEND_URL=http://backend:8000
