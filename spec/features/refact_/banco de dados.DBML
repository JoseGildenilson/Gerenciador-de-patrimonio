Project Comunica_Patrimonio {
  database_type: 'PostgreSQL'
  Note: 'Gestão de patrimônio de TI. Sem módulo financeiro, sem tickets e sem tags livres. Tipos, setores, situações e tipos de manutenção são catálogos extensíveis. Exclusões operacionais usam soft delete; registros históricos e tentativas de login não são apagados pela interface.'
}

Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique, note: 'Unicidade case-insensitive garantida via índice funcional LOWER(email) no PostgreSQL.']
  hashed_password varchar(255) [not null, note: 'Armazenar hash seguro; nunca a senha em texto puro.']
  role varchar(50) [not null, default: 'tecnico', note: 'Nesta versão, somente tecnico é permitido. Reforçar também com CHECK no PostgreSQL.']
  is_active boolean [not null, default: true, note: 'Permite desativar uma conta sem excluí-la logicamente.']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; e-mail permanece reservado após exclusão lógica.']

  indexes {
    (deleted_at)
    (is_active)
  }
}

Table equipment_types {
  id int [pk, increment]
  name varchar(100) [not null, unique, note: 'Nome padronizado (case-insensitive). Técnicos podem adicionar novos tipos.']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; ocultar das novas seleções e permitir restauração.']

  indexes {
    (deleted_at)
  }
}

Table sectors {
  id int [pk, increment]
  name varchar(100) [not null, unique, note: 'Nome padronizado (case-insensitive).']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; não existe is_active nem hierarquia de setores.']

  indexes {
    (deleted_at)
  }
}

Table equipment_statuses {
  id int [pk, increment]
  name varchar(100) [not null, unique, note: 'Valores iniciais: Em uso, Em manutenção, Baixado, Ocioso, Aguardando recolhimento, Alienação, Exposição e Acautelado.']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; ocultar das novas seleções e permitir restauração.']

  indexes {
    (deleted_at)
  }
}

Table maintenance_types {
  id int [pk, increment]
  name varchar(100) [not null, unique, note: 'Valores iniciais sugeridos: Preventiva e Corretiva. Técnicos podem adicionar novos tipos.']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; ocultar das novas seleções e permitir restauração.']

  indexes {
    (deleted_at)
  }
}

Table equipments {
  id int [pk, increment]
  patrimony_number varchar(255) [not null, unique, note: 'Obrigatório e único (case-insensitive) inclusive após soft delete; não reutilizar.']
  description text [note: 'Opcional.']
  serial_number varchar(255) [unique, note: 'Opcional e único (case-insensitive) inclusive após soft delete; não reutilizar.']
  hostname varchar(255) [note: 'Opcional; único (case-insensitive) apenas entre bens não excluídos logicamente.']
  brand varchar(255) [note: 'Opcional.']
  model varchar(255) [note: 'Modelo comercial; opcional. Substitui product_number.']
  equipment_type_id int [not null, ref: > equipment_types.id]
  sector_id int [not null, ref: > sectors.id, note: 'Setor atual; o cadastro inicial não gera movimentação.']
  status_id int [not null, ref: > equipment_statuses.id, note: 'Obrigatório, sem valor padrão.']
  ip_address inet [note: 'Opcional; endereço atual, sem histórico. Único entre bens não excluídos. Armazenar como endereço de host (/32 ou /128), sem máscara de rede.']
  mac_address macaddr [note: 'Opcional; endereço atual, sem histórico. Único entre bens não excluídos.']
  printer_identifier varchar(255) [note: 'Opcional; identificador de impressora da planilha. Único (case-insensitive) entre bens não excluídos.']
  windows_product_key_encrypted text [note: 'Opcional. Guardar somente valor criptografado; restringir e mascarar a exibição por padrão.']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado automaticamente via trigger em qualquer alteração do bem.']
  deleted_at timestamptz [note: 'Soft delete; bens excluídos ficam fora das consultas operacionais e podem ser restaurados.']

  indexes {
    (equipment_type_id)
    (sector_id)
    (status_id)
    (deleted_at)
  }
}

Table equipment_movements {
  id int [pk, increment]
  equipment_id int [not null, ref: > equipments.id]
  origin_sector_id int [not null, ref: > sectors.id]
  destination_sector_id int [not null, ref: > sectors.id]
  movement_date timestamptz [not null, default: `now()`, note: 'Data efetiva da transferência; preenchida inicialmente com a hora atual e editável pelo técnico. Não pode ser futura.']
  performed_by_user_id int [not null, ref: > users.id, note: 'Técnico que efetuou a movimentação; não é responsável permanente pelo bem.']
  notes text [note: 'Observações opcionais, incluindo motivo ou detalhes da transferência.']
  created_at timestamptz [not null, default: `now()`, note: 'Momento real do registro; não editável.']
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado automaticamente via trigger quando a movimentação for editada.']

  Note: 'Somente transferências concluídas. Não registrar movimentação no cadastro inicial. Não oferecer exclusão pela interface. Inclusões retroativas e edições devem ordenar o histórico por (movement_date ASC, id ASC), auto-ajustar o origin_sector_id do registro subsequente (garantindo Destino[n-1] = Origem[n]), validar que nenhuma etapa fique com origem == destino e recalcular equipments.sector_id na mesma transação.'

  indexes {
    (equipment_id, movement_date, id)
    (origin_sector_id)
    (destination_sector_id)
    (performed_by_user_id)
  }
}

Table equipment_maintenances {
  id int [pk, increment]
  equipment_id int [not null, ref: > equipments.id]
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz [note: 'NULL enquanto a manutenção estiver em andamento. Não pode ser anterior a started_at.']
  maintenance_type_id int [not null, ref: > maintenance_types.id]
  performed_by_user_id int [ref: > users.id, note: 'Opcional (NULL para cargas legadas/planilha); registra o técnico autenticado que abriu ou atualizou a manutenção pela interface.']
  description text [note: 'Opcional durante todo o ciclo da manutenção.']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Atualizado automaticamente via trigger ao editar ou concluir a manutenção.']

  Note: 'No máximo uma manutenção em andamento por bem. Ao iniciar, alterar a situação para Em manutenção; ao concluir, exigir que o técnico selecione a nova situação. Não oferecer exclusão pela interface.'

  indexes {
    (equipment_id, started_at)
    (maintenance_type_id)
    (performed_by_user_id)
  }
}

Table login_attempts {
  id int [pk, increment]
  email_attempted varchar(255) [not null, note: 'E-mail informado no formulário, mesmo se não existir um usuário correspondente. Nunca registrar a senha.']
  ip_address inet [not null]
  attempted_at timestamptz [not null, default: `now()`]
  success boolean [not null, default: false]

  Note: 'Registros de auditoria: sem exclusão pela interface. Aplicar política de retenção separadamente, caso necessária.'

  indexes {
    (ip_address, attempted_at)
    (email_attempted, attempted_at)
    (attempted_at)
  }
}